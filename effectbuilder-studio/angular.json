{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "effectbuilder-studio": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "lw",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": ["src/styles.scss"]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "budgets": [
                { "type": "initial", "maximumWarning": "4MB", "maximumError": "8MB" },
                { "type": "anyComponentStyle", "maximumWarning": "64kB", "maximumError": "128kB" }
              ]
            },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "effectbuilder-studio:build:production" },
            "development": { "buildTarget": "effectbuilder-studio:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
