{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch LoomWeaver V2 Backend (.NET 10)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-loomweaver-backend",
      "program": "${workspaceFolder}/backend/src/LoomWeaver.Api/bin/Debug/net10.0/LoomWeaver.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/src/LoomWeaver.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000"
      }
    }
  ],
  "compounds": [
    {
      "name": "Launch Full LoomWeaver V2 Stack (Backend + Frontend)",
      "configurations": ["Launch LoomWeaver V2 Backend (.NET 10)"],
      "preLaunchTask": "start-loomweaver-frontend",
      "stopAll": true
    }
  ]
}
