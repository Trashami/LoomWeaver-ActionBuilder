<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AssemblyName>LoomWeaver.Server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ServerEntry.cs" />
    <Content Include="src\LoomWeaver.Api\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="src\LoomWeaver.Api\LoomWeaver.Api.csproj" />
  </ItemGroup>
</Project>
